{#- The /become/ section page, first floor of three (owner's decision
    2026-10-23): the AREAS as cards. An area with at least one map is a link to
    /become/<area>/; an empty area would be a card without a link — none today.
    The card lists every direction the area declares, open ones plain and empty
    ones dimmed, so the whole landscape is visible from the first floor. All
    counts come from becomeTree — nothing is typed into the markup. #}
{%- set T = i18n[lang or "en"] %}
{%- set B = T.becomePage %}
<div class="home">

<div class="page-head">
  <p class="crumb"><a href="{{ T.paths.home }}">proofstone</a> / {{ B.crumb }}</p>
  <h1>{{ B.h1 }}</h1>
  <p class="page-head__intro">{{ B.intro }}</p>
  <p class="page-head__counts">{{ B.countsHtml(becomeTree.totals) | safe }}</p>
</div>

<div class="mcards">
  {%- for a in becomeTree.areas %}
  {%- set inner %}
    <div class="mcard__top">
      <span><span class="mcard__no">{{ a.no }}</span><h2 class="mcard__title">{{ a.title }}</h2></span>
      {{ B.shelfChipHtml(a.best, a.tally) | safe }}
    </div>
    <p class="mcard__desc">{{ a.desc }}</p>
    {#- Who is inside: the directions when the area names them; otherwise its
        professions, listed directly; an empty area says so and promises nothing
        but the first map. #}
    {%- if a.directions.length %}
    <p class="mcard__who"><span class="mcard__who-k">{{ B.directionsWord }}:</span>
      {%- for d in a.directions %}{% if d.open %}<span>{{ d.title | lower }}</span>{% else %}<span class="mcard__who-none">{{ d.title | lower }}</span>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {%- elif a.open %}
    <p class="mcard__who"><span class="mcard__who-k">{{ B.professionsWord }}:</span>
      {%- for c in a.cards %}{% if loop.index <= 4 %}<span>{{ (c.r.title | replace(" Roadmap", "")) if c.r else c.p.title }}</span>{% if not loop.last and loop.index < 4 %} · {% endif %}{% endif %}{% endfor %}
      {%- if a.cards.length > 4 %} · <span class="mcard__who-none">{{ B.moreWord(a.cards.length - 4) }}</span>{% endif %}</p>
    {%- else %}
    <p class="mcard__who"><span class="mcard__who-k">{{ B.professionsWord }}:</span> <span class="mcard__who-none">{{ B.noneYet }}</span></p>
    {%- endif %}
    {%- if a.open %}
    <p class="mcard__meta mcard__meta--row"><span>{{ B.tallyHtml(a.tally, a.directions.length) | safe }}</span><span class="mcard__go">{{ B.open }}</span></p>
    {%- endif %}
  {%- endset %}
  {%- if a.open %}
  <a class="mcard mcard--area" href="{{ T.paths.become }}{{ a.slug }}/">{{ inner | safe }}</a>
  {%- else %}
  <div class="mcard mcard--area mcard--shut">{{ inner | safe }}</div>
  {%- endif %}
  {%- endfor %}
</div>

</div>
